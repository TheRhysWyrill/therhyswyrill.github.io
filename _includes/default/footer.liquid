<footer class="site-footer">
    <div class="footer-inner">
        <div class="footer-brand">
            <a class="footer-title" href="{{ '/' | relative_url }}">{{ site.title }}</a>
            <p class="footer-tagline">Analysing performance, reviewing the experience, and archiving the journey.</p>
        </div>

        <nav class="footer-nav" aria-label="Footer">
            <a href="{{ '/reviews/' | relative_url }}">Reviews</a>
            <a href="{{ '/compatibility/' | relative_url }}">Is It Playable?</a>
            <a href="{{ '/content/' | relative_url }}">Video Vault</a>
            <a href="{{ '/live/' | relative_url }}">Livestream</a>
            <a href="{{ '/numbers/' | relative_url }}">The Numbers</a>
            <a href="{{ '/about/' | relative_url }}">About</a>
        </nav>

        <div class="footer-icons">
            <ul>
                <!-- Social icons from Font Awesome, if enabled -->
                {% include social/icons.liquid %}
            </ul>
        </div>
    </div>

    <p class="footer-legal">
        &copy; {{ site.time | date: '%Y' }} {{ site.title }}
        <span aria-hidden="true">·</span>
        <a href="{{ '/privacy/' | relative_url }}" title="Privacy policy">Privacy Policy</a>
        <span aria-hidden="true">·</span>
        <a href="{{ '/atom.xml' | relative_url }}" title="Atom feed of the latest reviews"><i class="fas fa-rss" aria-hidden="true"></i>&nbsp;RSS</a>
    </p>

    {% if site.mermaid %}
        <script type="module">
          mermaid.initialize({ startOnLoad: false, theme: "default" });
          mermaid.run({ nodes: [...document.querySelectorAll('.language-mermaid'), ...document.querySelectorAll('.mermaid')] });
        </script>
    {% endif %}
</footer>
