<!-- Automated theme icons stay active -->
{% if site.data.icons.github %}
  <a class="clear" href="https://github.com/{{ site.data.icons.github }}" rel="noreferrer" target="_blank" title="GitHub">
    <i class="fa-brands fa-github" aria-hidden="true"></i>
  </a>
{% endif %}

{% if site.data.icons.twitch %}
  <a class="clear" href="https://twitch.tv/{{ site.data.icons.twitch }}" rel="noreferrer" target="_blank" title="Twitch">
    <i class="fa-brands fa-twitch" aria-hidden="true"></i>
  </a>
{% endif %}

